# 必填：会话/加密密钥，至少 16 字符。生成方式：openssl rand -hex 32
APP_SECRET=

# development | production
NODE_ENV=development

# GitHub OAuth App（生产必填；开发环境可留空，仅在 DEV_FAKE_GITHUB=1 时使用假登录）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 前端地址：登录后跳转与 CSRF Origin 基准
FRONTEND_URL=http://localhost:5173

# 必须与 GitHub OAuth App 中登记的 callback 一致
OAUTH_CALLBACK_URL=http://localhost:5173/auth/github/callback

# 可选：服务端读取仓库/README 时提升 GitHub API 限额
GITHUB_TOKEN=

# AI 评估（OpenAI 兼容 /chat/completions）。AI_API_KEY 留空则使用启发式评分
# 也可在管理面板「AI 设置」覆盖，保存即生效、无需重启
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# 管理员 GitHub 登录名，逗号分隔（不区分大小写），每次登录同步
ADMIN_GITHUB_LOGINS=

# 仅开发：1 时启用假 GitHub 与 /auth/dev/login。生产为 1 会拒绝启动
DEV_FAKE_GITHUB=0

# SQLite 数据目录
DATA_DIR=./data

# 服务端口
PORT=3001
